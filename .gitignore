# Superpowers specs/plans are transient working artifacts — durable decisions
# live in docs/adr/; active plans may exist on disk untracked
docs/superpowers/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Rust
target/
*.db-shm
*.db-wal

# Runtime data (SQLite DB + files) — never committed
/data/

# Apple Health exports — multi-GB dumps of personal health records.
# Landing one here is normal (healthie-backend import-apple-health reads it);
# committing one never is.
/apple_health_export/
/export.zip

# Local MCP server config — holds a personal LAN bearer token; never commit
.mcp.json

# Filled-in copy of deploy/.env.example, installed to the box as
# /opt/healthie/.env. Carries no secret today, but it is per-machine
# configuration and the template is what belongs in git.
/deploy/.env
